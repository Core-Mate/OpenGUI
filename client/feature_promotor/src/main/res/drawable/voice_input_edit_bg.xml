<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="#FF45B2"
                android:endColor="#7C3FFF"
                android:startColor="#0573FF"
                android:type="linear"/>

            <corners android:radius="16dp"/>
        </shape>
    </item>


    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Inner background color. -->
            <corners android:radius="16dp" /> <!-- 2dp smaller than the border radius. -->
        </shape>
    </item>

</layer-list>
