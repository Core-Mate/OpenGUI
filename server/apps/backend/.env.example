# OpenGUI Server Environment Configuration
# Copy this file to .env and fill in your values

# App
NODE_ENV=development
PORT=7777

# Database (matches docker defaults)
DATABASE_URL=postgresql://opengui:opengui@localhost:5432/opengui

# Redis (matches docker defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI model config (used by all graph agents)
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.6-plus

# LangSmith tracing (optional, for debugging agent execution)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=opengui
# LANGCHAIN_CALLBACKS_BACKGROUND=true

# ========== IM Channel (Remote Task Dispatch) ==========
# Configure to enable remote control via IM. Only channels with credentials are activated.
# Without these, the IM channel module loads but does nothing.

# Feishu/Lark Bot — WebSocket mode, no public IP needed
# 1. Create app at https://open.feishu.cn → get App ID + Secret
# 2. Enable "Bot" capability, add im:message permission
# 3. In "Event Subscription", choose WebSocket mode
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxx

# Telegram Bot — long polling mode, no public IP needed
# 1. Message @BotFather on Telegram → /newbot → get token
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
